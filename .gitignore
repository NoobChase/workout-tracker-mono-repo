# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# CDK
cdk.out/
.cdk.staging/

# Secrets and local config — connection strings live in SSM, never in the repo
.env
.env.*
!.env.example
# The one exception: public, build-time values only (Clerk's publishable key
# ships in the JS bundle anyway). Never put a secret in it.
!apps/web/.env.production
*.pem

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Editor / OS
.DS_Store
.vscode/
.idea/

# Agent local settings (CLAUDE.md itself is tracked, deliberately)
.claude/settings.local.json

# Legacy analysis — local reference only, never tracked.
# Contains a raw MySQL export from the old system with real account data.
# Its conclusions already live in data-model.md section 6 and the build plan,
# so nothing tracked depends on these files being present.
docs/legacy-*

# Impeccable: the per-session hook cache (absolute paths, session ids) and the
# review screenshots it regenerates. config.json is tracked -- it holds the
# detector's deliberate ignore rules.
.impeccable/hook.cache.json
.impeccable/review/

# Agent worktrees (Claude Code isolation).
.claude/worktrees/
